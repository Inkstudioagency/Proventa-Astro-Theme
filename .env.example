# Leave STRAPI_URL unset (or delete this file) to build from the content
# snapshot committed at src/data/ — that is the default and needs no backend.
#
# Set it only while authoring content against a running Strapi, then run
# `npm run snapshot` to freeze your changes back into the repo.
#
# STRAPI_URL=http://localhost:1337

# Only needed if you lock the Strapi Public role down.
# STRAPI_TOKEN=
