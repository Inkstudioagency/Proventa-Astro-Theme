---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title={`Style Guide || Webflow HTML Website Template`}
  wfPage="6a6ade7014d4ca494252bfd2"
  description={`Proventa is a conversion-focused Webflow template for Business, Software, and SaaS companies to present products with clarity, capture leads, build trust, and establish a modern, professional online presence that drives growth and credibility.`}
  ogImage={`https://cdn.prod.website-files.com/69df29ae693be6c15d65e13f/69e92760f35acb5c0b3b554f_open%20graph%20image%20(7).png`}
>
  <div class="page-wrapper">
    <Navbar />
    <main class="main-wrapper">
      <section class="section_style-guide">
        <div class="section-gap">
          <div class="w-layout-blockcontainer container-main w-container">
            <div class="style-guide-wrapper">
              <div class="section-heading-block">
                <div class="section-title-block">
                  <h1 class="heading-style-2 title-animation">Style Guide</h1>
                </div>
                <div class="section-summary-block top-space">
                  <p class="paragraph-small text-align-center summary-animation">The visual foundation and design system of our SaaS platform.</p>
                </div>
              </div>
              <div class="style-guide-content-block">
                <div class="style-guide-single-content">
                  <div class="style-guide-content-left-block"><img loading="lazy" src="/images/color-icon.svg" alt="style-guide-content-icon" class="style-guide-content-icon">
                    <div class="label-medium text-weight-semi-bold title-text-color">Color Palette</div>
                  </div>
                  <div class="style-guide-content-right-block">
                    <div class="color-content-block">
                      <div class="color-single-block">
                        <div class="color-block primary-color"></div>
                        <div class="color-info-block">
                          <div class="label-medium text-weight-semi-bold deep-black-color">primary-color</div>
                          <div class="color-code">#1c6de5</div>
                        </div>
                      </div>
                      <div class="color-single-block">
                        <div class="color-block deep-strock-color"></div>
                        <div class="color-info-block">
                          <div class="label-medium text-weight-semi-bold deep-black-color">deep-strock-color</div>
                          <div class="color-code">#e0e0e0</div>
                        </div>
                      </div>
                      <div class="color-single-block">
                        <div class="color-block main-strock-color"></div>
                        <div class="color-info-block">
                          <div class="label-medium text-weight-semi-bold deep-black-color">main-strock-color</div>
                          <div class="color-code">#e5e5e5</div>
                        </div>
                      </div>
                      <div class="color-single-block">
                        <div class="color-block black-color"></div>
                        <div class="color-info-block">
                          <div class="label-medium text-weight-semi-bold deep-black-color">light-strock-color</div>
                          <div class="color-code">#f1f5f9</div>
                        </div>
                      </div>
                      <div class="color-single-block">
                        <div class="color-block white-color"></div>
                        <div class="color-info-block">
                          <div class="label-medium text-weight-semi-bold deep-black-color">white-color</div>
                          <div class="color-code">#ffffff</div>
                        </div>
                      </div>
                      <div class="color-single-block">
                        <div class="color-block light-black-color"></div>
                        <div class="color-info-block">
                          <div class="label-medium text-weight-semi-bold deep-black-color">light-black-color</div>
                          <div class="color-code">#181818</div>
                        </div>
                      </div>
                      <div class="color-single-block">
                        <div class="color-block deep-black-color"></div>
                        <div class="color-info-block">
                          <div class="label-medium text-weight-semi-bold deep-black-color">deep-black-color</div>
                          <div class="color-code">#0a0a0a</div>
                        </div>
                      </div>
                      <div class="color-single-block">
                        <div class="color-block porcelain-color deep-color"></div>
                        <div class="color-info-block">
                          <div class="label-medium text-weight-semi-bold deep-black-color">deep-color</div>
                          <div class="color-code">#0a253b</div>
                        </div>
                      </div>
                      <div class="color-single-block">
                        <div class="color-block gray-color"></div>
                        <div class="color-info-block">
                          <div class="label-medium text-weight-semi-bold deep-black-color">gray-color</div>
                          <div class="color-code">#354959</div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="style-guide-single-content">
                  <div class="style-guide-content-left-block"><img loading="lazy" src="https://cdn.prod.website-files.com/699593b9c22fcf3447bf7d91/6996aa095140842e10ec173b_Licenses%20Icon.svg" alt="style-guide-content-icon" class="style-guide-content-icon">
                    <div class="label-medium text-weight-semi-bold title-text-color">Typography</div>
                  </div>
                  <div class="style-guide-content-right-block">
                    <div class="typography-content-block">
                      <div class="typography-single-block">
                        <div class="typography-text-block">
                          <h1>Heading 1</h1>
                        </div>
                        <div class="typography-info-block">
                          <div class="paragraph-xsmall text-weight-medium">Plus Jakarta Sans Medium • 66px • 1.2 Line Height</div>
                        </div>
                      </div>
                      <div class="typography-single-block">
                        <div class="typography-text-block">
                          <h2 class="heading">Heading 2</h2>
                        </div>
                        <div class="typography-info-block">
                          <div class="paragraph-xsmall text-weight-medium">Plus Jakarta Sans Medium • 48px • 1.2 Line Height</div>
                        </div>
                      </div>
                      <div class="typography-single-block">
                        <div class="typography-text-block">
                          <h3 class="heading-2">Heading 3</h3>
                        </div>
                        <div class="typography-info-block">
                          <div class="paragraph-xsmall text-weight-medium">Plus Jakarta Sans Medium • 34px • 1.2 Line Height</div>
                        </div>
                      </div>
                      <div class="typography-single-block">
                        <div class="typography-text-block">
                          <h4>Heading 4</h4>
                        </div>
                        <div class="typography-info-block">
                          <div class="paragraph-xsmall text-weight-medium">Plus Jakarta Sans Medium • 32px • 1.2 Line Height</div>
                        </div>
                      </div>
                      <div class="typography-single-block">
                        <div class="typography-text-block">
                          <h5>Heading 5</h5>
                        </div>
                        <div class="typography-info-block">
                          <div class="paragraph-xsmall text-weight-medium">Plus Jakarta Sans Medium • 24px • 1.2 Line Height</div>
                        </div>
                      </div>
                      <div class="typography-single-block">
                        <div class="typography-text-block">
                          <h6>Heading 6</h6>
                        </div>
                        <div class="typography-info-block">
                          <div class="paragraph-xsmall text-weight-medium">Plus Jakarta Sans Medium • 20px • 1.2 Line Height</div>
                        </div>
                      </div>
                      <div class="typography-single-block">
                        <div class="typography-text-block">
                          <p class="text-size-large">Paragraph Regular: The quick brown fox jumps over the lazy dog. Designers use this text as a placeholder.</p>
                        </div>
                        <div class="typography-info-block">
                          <div class="paragraph-xsmall text-weight-medium">Plus Jakarta Sans Regular • 18px • 1.5 Line Height</div>
                        </div>
                      </div>
                      <div class="typography-single-block">
                        <div class="typography-text-block">
                          <p class="text-size-regular">Paragraph Small: The quick brown fox jumps over the lazy dog. Designers use this text as a placeholder.</p>
                        </div>
                        <div class="typography-info-block">
                          <div class="paragraph-xsmall text-weight-medium">Plus Jakarta Sans Regular • 16px • 1.5 Line Height</div>
                        </div>
                      </div>
                      <div class="typography-single-block">
                        <div class="typography-text-block">
                          <p class="text-size-small">Paragraph Xsmall: The quick brown fox jumps over the lazy dog. Designers use this text as a placeholder.</p>
                        </div>
                        <div class="typography-info-block">
                          <div class="paragraph-xsmall text-weight-medium">Plus Jakarta Sans Regular • 14px • 1.5 Line Height</div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="style-guide-single-content border-none">
                  <div class="style-guide-content-left-block"><img loading="lazy" src="/images/Interactive-Icon.svg" alt="style-guide-content-icon" class="style-guide-content-icon">
                    <div class="label-medium text-weight-semi-bold title-text-color">Interactive Elements</div>
                  </div>
                  <div class="style-guide-content-right-block">
                    <div class="interactive-content-block">
                      <div class="button-varients-block">
                        <div class="button-varients-title-block">
                          <div class="label-large">Button Variants</div>
                        </div>
                        <div class="button-varients-content-block">
                          <a href="#" data-wf--primary-button--variant="v1" class="primary-button w-inline-block">
                            <div class="button-content-block">
                              <div class="button-text-block">
                                <div class="button-text is-1">Get Started for free</div>
                                <div class="button-text is-2">Get Started for free</div>
                              </div>
                            </div>
                          </a>
                          <a data-wf--secondary-button--variant="v1" href="#" class="secondary-button w-inline-block">
                            <div class="button-text-block">
                              <div class="button-text is-1">Get Started</div>
                              <div class="button-text is-2">Get Started</div>
                            </div>
                          </a>
                        </div>
                      </div>
                      <div class="icon-varients-block">
                        <div class="icon-varients-title-block">
                          <div class="label-large">Icon</div>
                        </div>
                        <div class="icon-varients-content-block"><img loading="lazy" src="/images/List-Item-Icon-2.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/List-Item-Icon.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/correct-Icon.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/testimonial-icon-1.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="https://cdn.prod.website-files.com/699593b9c22fcf3447bf7d91/6996aa095140842e10ec174b_Licenses%20Icon-1.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="https://cdn.prod.website-files.com/699593b9c22fcf3447bf7d91/6996aa095140842e10ec1749_Licenses%20Icon-3.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/Features-Icon.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/Process-Icon-4.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/select-arrow.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/Menu-Open-Icon.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/Process-Icon-2.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/Process-Icon-3.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/Process-Icon-1.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/w1hy-choose-card-icon-.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/why-choose-card-content-block-4.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/Star-Icon.svg" alt="style-guide-icon" class="style-guide-icon"></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
