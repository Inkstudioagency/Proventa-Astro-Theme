---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title={`Contact || Saas Astro Theme`}
  wfPage="6a6ade7014d4ca494252bfd9"
  description={`Proventa is a conversion-focused Astro theme for Business, Software, and SaaS companies to present products with clarity, capture leads, build trust, and establish a modern, professional online presence that drives growth and credibility.`}
  ogImage={`https://cdn.prod.website-files.com/69df29ae693be6c15d65e13f/69e92760f35acb5c0b3b554f_open%20graph%20image%20(7).png`}
>
  <div class="page-wrapper">
    <Navbar />
    <main class="main-wrapper">
      <section class="section_hero">
        <div class="hero-gap contact">
          <div class="w-layout-blockcontainer container-main w-container">
            <div class="hero-wrapper horizontal center">
              <div class="hero-content-block left">
                <div class="hero-title-block">
                  <h1 class="heading-style-1 text-align-left title-animation">Get In Touch</h1>
                </div>
                <div class="hero-summary-block top-gap-sm">
                  <p class="text-size-large summary-animation">Join the hundreds of companies that trust Proventa to enhance and strengthen their encryption solutions.</p>
                </div>
                <div data-w-id="29a07045-863b-290e-5ff9-4d8c40108314" style="opacity:0" class="hero-point-block">
                  <ul role="list" class="solution-card-point-list">
                    <li class="solution-card-point">Employee Profiles &amp; Management</li>
                    <li class="solution-card-point">Project Tracking &amp; Task Details</li>
                    <li class="solution-card-point">Scheduling &amp; Time Management</li>
                  </ul>
                </div>
              </div>
              <div data-w-id="821d6a07-8f10-bbaf-0785-e6fd6180f7c8" style="opacity:0;-webkit-transform:translate3d(0, 80px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 80px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 80px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 80px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)" class="contact-form-block">
                <div class="contact-form w-form">
                  <form id="email-form" name="email-form" data-name="Email Form" method="get" class="contact-form-inner" data-wf-page-id="6a6ade7014d4ca494252bfd9" data-wf-element-id="4b1164c1-d64a-bc79-ab92-386492e39690">
                    <div class="contact-form-content full">
                      <div class="contact-form-field-block"><label for="Name" class="contact-form-field-label">Name</label><input class="contact-form-text-field w-input" maxlength="256" name="Name" data-name="Name" placeholder="Enter your name" type="text" id="Name" required=""></div>
                      <div class="contact-form-field-block"><label for="Email-address" class="contact-form-field-label">Email address</label><input class="contact-form-text-field w-input" maxlength="256" name="Email-address" data-name="Email address" placeholder="Enter your email" type="email" id="Email-address" required=""></div>
                      <div class="contact-form-field-block"><label for="Phone-number" class="contact-form-field-label">Phone number</label><input class="contact-form-text-field w-input" maxlength="256" name="Phone-number" data-name="Phone number" placeholder="Enter your number" type="tel" id="Phone-number" required=""></div>
                      <div class="contact-form-field-block"><label for="Address" class="contact-form-field-label">Address</label><input class="contact-form-text-field w-input" maxlength="256" name="Address" data-name="Address" placeholder="Enter your address" type="text" id="Address" required=""></div>
                      <div class="contact-form-field-block"><label for="Message" class="contact-form-field-label">Message</label><textarea placeholder="Tell us how we can help you. " maxlength="5000" id="Message" name="Message" data-name="Message" class="contact-form-text-field lg w-input"></textarea></div>
                      <div class="contact-form-button-block"><input type="submit" data-wait="Please wait..." class="primary-button form w-button" value="Get Started for free"></div>
                    </div>
                  </form>
                  <div class="success-message w-form-done">
                    <div>Thank you! Your submission has been received!</div>
                  </div>
                  <div class="w-form-fail">
                    <div>Oops! Something went wrong while submitting the form.</div>
                  </div>
                </div>
              </div>
            </div>
            <div data-w-id="090b8f13-ad68-8501-41a7-39fbce0358d8" style="opacity:0;-webkit-transform:translate3d(0, 80px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 80px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 80px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 80px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)" class="logo-wrapper top-space">
              <div class="section-heading-block bottom-gap-sm">
                <div class="section-title-block">
                  <div class="text-size-large text-align-center text-weight-medium text-color-black">Trusted by Industry Leaders Across the Globe</div>
                </div>
              </div>
              <div data-w-id="090b8f13-ad68-8501-41a7-39fbce0358dd" class="logo-content-block">
                <div class="logo-row-block"><img loading="lazy" src="/images/Zantic.svg" alt="logo" class="logo"><img loading="lazy" src="/images/Flikbox.svg" alt="logo" class="logo"><img loading="lazy" src="/images/Digice.svg" alt="logo" class="logo"><img loading="lazy" src="/images/Crona.svg" alt="logo" class="logo"><img loading="lazy" src="/images/Unify.svg" alt="logo" class="logo"><img loading="lazy" src="/images/Unicoin.svg" alt="logo" class="logo"><img loading="lazy" src="/images/Tapline.svg" alt="logo" class="logo"><img loading="lazy" src="/images/Tandem.svg" alt="logo" class="logo"><img loading="lazy" src="/images/Heline.svg" alt="logo" class="logo"><img loading="lazy" src="/images/Pera.svg" alt="logo" class="logo"></div>
                <div class="logo-row-block"><img loading="lazy" src="/images/Zantic.svg" alt="logo" class="logo"><img loading="lazy" src="/images/Flikbox.svg" alt="logo" class="logo"><img loading="lazy" src="/images/Digice.svg" alt="logo" class="logo"><img loading="lazy" src="/images/Crona.svg" alt="logo" class="logo"><img loading="lazy" src="/images/Unify.svg" alt="logo" class="logo"><img loading="lazy" src="/images/Unicoin.svg" alt="logo" class="logo"><img loading="lazy" src="/images/Tapline.svg" alt="logo" class="logo"><img loading="lazy" src="/images/Tandem.svg" alt="logo" class="logo"><img loading="lazy" src="/images/Heline.svg" alt="logo" class="logo"><img loading="lazy" src="/images/Pera.svg" alt="logo" class="logo"></div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section id="section_faq" class="section_faq">
        <div class="section-gap">
          <div class="w-layout-blockcontainer container-sm w-container">
            <div class="faq-wrapper">
              <div class="section-heading-block container-main">
                <div class="section-title-block max-width-32rem">
                  <h2 class="heading-style-2 text-align-center title-animation">Frequently Asked Questions</h2>
                </div>
                <div class="section_summary_block top-space max-width-32rem">
                  <p class="text-size-large text-align-center summary-animation">Find quick answers to common questions about Proventa’s products, services, orders, shipping, and returns.</p>
                </div>
              </div>
              <div class="faq-content-block">
                <div data-delay="600" data-hover="false" data-w-id="298f7823-0002-6bbd-a0f4-d83d86bd6f62" class="faq-dropdown-block w-dropdown">
                  <div class="faq-question-block w-dropdown-toggle">
                    <div class="faq-question">What determines pricing in the Scale and Enterprise tier?</div>
                    <div class="faq-icon-block">
                      <div class="faq-icon w-embed"><svg width="20" height="20" viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M8.00049 3.8335C8.09239 3.83367 8.1665 3.90855 8.1665 4.00049V7.8335H12.0005C12.0924 7.83367 12.1665 7.90854 12.1665 8.00049C12.1663 8.09229 12.0923 8.16633 12.0005 8.1665H8.1665V12.0005C8.16633 12.0923 8.09229 12.1663 8.00049 12.1665C7.90854 12.1665 7.83367 12.0924 7.8335 12.0005V8.1665H4.00049C3.90855 8.1665 3.83367 8.09239 3.8335 8.00049C3.8335 7.90844 3.90844 7.8335 4.00049 7.8335H7.8335V4.00049C7.8335 3.90844 7.90844 3.8335 8.00049 3.8335Z" fill="#353739" stroke="#353739"></path>
                        </svg></div>
                    </div>
                  </div>
                  <nav class="faq-answer-block w-dropdown-list">
                    <div class="faq-answer-inner">
                      <p class="faq-answer">Usually number of employees (active users), access to advanced reporting, dedicated account manager, API access, custom compliance features, and volume of payroll runs.</p>
                    </div>
                  </nav>
                </div>
                <div data-delay="600" data-hover="false" data-w-id="298f7823-0002-6bbd-a0f4-d83d86bd6f6c" class="faq-dropdown-block w-dropdown">
                  <div class="faq-question-block w-dropdown-toggle">
                    <div class="faq-question">What does the onboarding process look like?</div>
                    <div class="faq-icon-block">
                      <div class="faq-icon w-embed"><svg width="20" height="20" viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M8.00049 3.8335C8.09239 3.83367 8.1665 3.90855 8.1665 4.00049V7.8335H12.0005C12.0924 7.83367 12.1665 7.90854 12.1665 8.00049C12.1663 8.09229 12.0923 8.16633 12.0005 8.1665H8.1665V12.0005C8.16633 12.0923 8.09229 12.1663 8.00049 12.1665C7.90854 12.1665 7.83367 12.0924 7.8335 12.0005V8.1665H4.00049C3.90855 8.1665 3.83367 8.09239 3.8335 8.00049C3.8335 7.90844 3.90844 7.8335 4.00049 7.8335H7.8335V4.00049C7.8335 3.90844 7.90844 3.8335 8.00049 3.8335Z" fill="#353739" stroke="#353739"></path>
                        </svg></div>
                    </div>
                  </div>
                  <nav class="faq-answer-block w-dropdown-list">
                    <div class="faq-answer-inner">
                      <p class="faq-answer">Typically kickoff call, data migration (employee info, payroll history), system setup, admin training, parallel payroll testing, go-live support. Usually 2–6 weeks.</p>
                    </div>
                  </nav>
                </div>
                <div data-delay="600" data-hover="false" data-w-id="298f7823-0002-6bbd-a0f4-d83d86bd6f76" class="faq-dropdown-block w-dropdown">
                  <div class="faq-question-block w-dropdown-toggle">
                    <div class="faq-question">Does Proventa charge a % of revenue?</div>
                    <div class="faq-icon-block">
                      <div class="faq-icon w-embed"><svg width="20" height="20" viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M8.00049 3.8335C8.09239 3.83367 8.1665 3.90855 8.1665 4.00049V7.8335H12.0005C12.0924 7.83367 12.1665 7.90854 12.1665 8.00049C12.1663 8.09229 12.0923 8.16633 12.0005 8.1665H8.1665V12.0005C8.16633 12.0923 8.09229 12.1663 8.00049 12.1665C7.90854 12.1665 7.83367 12.0924 7.8335 12.0005V8.1665H4.00049C3.90855 8.1665 3.83367 8.09239 3.8335 8.00049C3.8335 7.90844 3.90844 7.8335 4.00049 7.8335H7.8335V4.00049C7.8335 3.90844 7.90844 3.8335 8.00049 3.8335Z" fill="#353739" stroke="#353739"></path>
                        </svg></div>
                    </div>
                  </div>
                  <nav class="faq-answer-block w-dropdown-list">
                    <div class="faq-answer-inner">
                      <p class="faq-answer">Most HR/payroll software charges per employee per month (flat fee), not a percentage of revenue. But some PEOs or payroll providers with workers’ comp or benefits might use % of payroll. You must verify directly.</p>
                    </div>
                  </nav>
                </div>
                <div data-delay="600" data-hover="false" data-w-id="298f7823-0002-6bbd-a0f4-d83d86bd6f80" class="faq-dropdown-block w-dropdown">
                  <div class="faq-question-block w-dropdown-toggle">
                    <div class="faq-question">What happens if I don’t want to move forward after my free trial?</div>
                    <div class="faq-icon-block">
                      <div class="faq-icon w-embed"><svg width="20" height="20" viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M8.00049 3.8335C8.09239 3.83367 8.1665 3.90855 8.1665 4.00049V7.8335H12.0005C12.0924 7.83367 12.1665 7.90854 12.1665 8.00049C12.1663 8.09229 12.0923 8.16633 12.0005 8.1665H8.1665V12.0005C8.16633 12.0923 8.09229 12.1663 8.00049 12.1665C7.90854 12.1665 7.83367 12.0924 7.8335 12.0005V8.1665H4.00049C3.90855 8.1665 3.83367 8.09239 3.8335 8.00049C3.8335 7.90844 3.90844 7.8335 4.00049 7.8335H7.8335V4.00049C7.8335 3.90844 7.90844 3.8335 8.00049 3.8335Z" fill="#353739" stroke="#353739"></path>
                        </svg></div>
                    </div>
                  </div>
                  <nav class="faq-answer-block w-dropdown-list">
                    <div class="faq-answer-inner">
                      <p class="faq-answer">Usually you simply cancel, no charge. Your data may be exported or deleted according to their privacy policy. No auto-renewal unless you provide billing info and agree to a paid plan.</p>
                    </div>
                  </nav>
                </div>
                <div data-delay="600" data-hover="false" data-w-id="298f7823-0002-6bbd-a0f4-d83d86bd6f8a" class="faq-dropdown-block w-dropdown">
                  <div class="faq-question-block w-dropdown-toggle">
                    <div class="faq-question">How much are the add-ons?</div>
                    <div class="faq-icon-block">
                      <div class="faq-icon w-embed"><svg width="20" height="20" viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M8.00049 3.8335C8.09239 3.83367 8.1665 3.90855 8.1665 4.00049V7.8335H12.0005C12.0924 7.83367 12.1665 7.90854 12.1665 8.00049C12.1663 8.09229 12.0923 8.16633 12.0005 8.1665H8.1665V12.0005C8.16633 12.0923 8.09229 12.1663 8.00049 12.1665C7.90854 12.1665 7.83367 12.0924 7.8335 12.0005V8.1665H4.00049C3.90855 8.1665 3.83367 8.09239 3.8335 8.00049C3.8335 7.90844 3.90844 7.8335 4.00049 7.8335H7.8335V4.00049C7.8335 3.90844 7.90844 3.8335 8.00049 3.8335Z" fill="#353739" stroke="#353739"></path>
                        </svg></div>
                    </div>
                  </div>
                  <nav class="faq-answer-block w-dropdown-list">
                    <div class="faq-answer-inner">
                      <p class="faq-answer">Varies widely  e.g., time tracking ($3–8/user/month), benefits admin ($5–10/user/month), background checks (per check fee), API access (extra monthly fee). Only Proventa can give exact numbers.</p>
                    </div>
                  </nav>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
