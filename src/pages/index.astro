---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const jsonLd = `{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Proventa",
  "url": "/",
  "description": "A powerful user management platform offering the most comprehensive set of features for streamlined access, control, and administration. Manage people, projects, and performance with global payroll, automated onboarding, time tracking, and compliance tools.",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "inLanguage": "en",
  "offers": [
    {
      "@type": "Offer",
      "name": "Basic Plan",
      "description": "Up to 25 employees with basic HR features, core HR workflows, time-off tracking, essential integrations, and community support access",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock"
    },
    {
      "@type": "Offer",
      "name": "Teams Pricing",
      "description": "Up to 100 employees with performance management tools, customizable workflows, dedicated support team, and advanced reporting",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock"
    },
    {
      "@type": "Offer",
      "name": "Enterprise",
      "description": "Unlimited employees with dedicated account manager, custom integrations, 24/7 priority support, and compliance assistance",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock"
    }
  ],
  "featureList": [
    "Global Payroll",
    "Automated Onboarding",
    "Time & Attendance Tracking",
    "Performance Review",
    "Employee Directory",
    "Compliance & Security",
    "Real-time Project Evaluation",
    "Smart Timer",
    "Advanced Schedule System",
    "Salary Distribution Analysis"
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5",
    "bestRating": "5",
    "reviewCount": "4"
  },
  "review": [
    {
      "@type": "Review",
      "author": {
        "@type": "Person",
        "name": "Ethan Williams",
        "jobTitle": "Digital Marketing Specialist"
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5",
        "bestRating": "5"
      },
      "reviewBody": "Before using this platform, our HR processes were scattered across multiple tools and spreadsheets. Now everything is centralised in one place—from hiring to payroll to performance tracking."
    },
    {
      "@type": "Review",
      "author": {
        "@type": "Person",
        "name": "Daniel Thompson",
        "jobTitle": "Manager"
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5",
        "bestRating": "5"
      },
      "reviewBody": "Managing employee records, leave requests, and internal processes used to be overwhelming. With this system, everything is organised and automated. It has truly improved."
    },
    {
      "@type": "Review",
      "author": {
        "@type": "Person",
        "name": "Michael Anderson",
        "jobTitle": "Administrator"
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5",
        "bestRating": "5"
      },
      "reviewBody": "Before using this platform, our HR processes were scattered across multiple tools and spreadsheets. Now everything is centralised in one place—from hiring to payroll to performance tracking."
    },
    {
      "@type": "Review",
      "author": {
        "@type": "Person",
        "jobTitle": "Coordinator"
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5",
        "bestRating": "5"
      },
      "reviewBody": "We reduced payroll errors to zero within the first month. The system is intuitive, fast, and reliable—exactly what we needed."
    }
  ]
}`;
import { getBlogs } from '../lib/strapi';
import CollectionList from '../components/CollectionList.astro';
import BlogCard from '../components/BlogCard.astro';
import FeaturedBlogCard from '../components/FeaturedBlogCard.astro';
const blogs = await getBlogs();
const homeFeatured = blogs.filter((b) => b.isFeatured).slice(0, 1);
const rest = blogs.filter((b) => !b.isFeatured);
const homeSecond = rest.slice(0, 1);
// second row spans all three grid columns
const homeRest = rest.slice(1, 4);
const slide1 = blogs.slice(0, 1);
const slide2 = blogs.slice(1, 2);
const slide3 = blogs.slice(2, 3);
const slide4 = blogs.slice(3, 4);
const slide5 = blogs.slice(4, 5);
---

<BaseLayout
  title={`Proventa - Saas Astro Theme`}
  wfPage="6a6ade7014d4ca494252bfcf"
  description={`Proventa is a conversion-focused Astro theme for Business, Software, and SaaS companies to present products with clarity, capture leads, build trust, and establish a modern, professional online presence that drives growth and credibility.`}
  ogImage={`https://cdn.prod.website-files.com/69df29ae693be6c15d65e13f/69e92760f35acb5c0b3b554f_open%20graph%20image%20(7).png`}
  jsonLd={jsonLd}
