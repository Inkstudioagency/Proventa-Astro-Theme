---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={`Sign Up || Saas Astro Theme`}
  wfPage="6a6ade7014d4ca494252bfe6"
  description={`Proventa is a conversion-focused Astro theme for Business, Software, and SaaS companies to present products with clarity, capture leads, build trust, and establish a modern, professional online presence that drives growth and credibility.`}
  ogImage={`https://cdn.prod.website-files.com/69df29ae693be6c15d65e13f/69e92760f35acb5c0b3b554f_open%20graph%20image%20(7).png`}
>
  <section class="section-authenticaton">
    <div class="authenticaton-wrapper">
      <div class="authenticaton-image-block">
        <div class="authenticaton-dashboard-block"><img src="/images/HR-SaaS.jpg" loading="lazy" sizes="(max-width: 549px) 100vw, 549px" srcset="/images/HR-SaaS-p-500.jpg 500w, /images/HR-SaaS.jpg 549w" alt="authenticaton-dashboard" class="authenticaton-dashboard"></div>
        <div class="authenticaton-heading-block">
          <div class="authenticaton-title-block">
            <h1 class="authenticaton-title">Built to Solve Real Business Challenges</h1>
          </div>
          <div class="authenticaton-summary-block">
            <p class="authenticaton-summary">Boost productivity by 35%, eliminate time theft, stay on budget, and make every hour count with intelligent workforce management.</p>
          </div>
        </div>
        <div class="authenticaton-navigation-block">
          <div class="authenticaton-single-nav-block">
            <div class="authenticaton-nav-overlay"></div>
          </div>
          <div class="authenticaton-single-nav-block">
            <div class="authenticaton-nav-overlay"></div>
          </div>
          <div class="authenticaton-single-nav-block">
            <div class="authenticaton-nav-overlay"></div>
          </div>
          <div class="authenticaton-single-nav-block">
            <div class="authenticaton-nav-overlay"></div>
          </div>
        </div>
      </div>
      <div class="authenticaton-form-block">
        <div class="authentication-form w-form">
          <form id="email-form" name="email-form" data-name="Email Form" method="get" class="contact-form-inner" data-wf-page-id="6a6ade7014d4ca494252bfe6" data-wf-element-id="a8c72494-4a33-c825-186b-a6d66b9dd4f8">
            <a href="#" class="auth-logo-block w-inline-block"><img src="/images/nav-logo-2.svg" loading="lazy" alt="nav-logo" class="auth-logo"></a>
            <div class="auth-form-content">
              <div class="auth-form-heading-block">
                <h2 class="heading-style-5">Sign Up</h2>
                <p class="body-text-sm">Please Sign Up to continue to your account.</p>
              </div>
              <div class="contact-form-field-block"><label for="Name" class="contact-form-field-label">Full name</label><input class="contact-form-text-field w-input" maxlength="256" name="Name" data-name="Name" placeholder="Write name here" type="text" id="Name" required=""></div>
              <div class="contact-form-field-block"><label for="Email-address" class="contact-form-field-label">Email address</label><input class="contact-form-text-field w-input" maxlength="256" name="Email-address" data-name="Email address" placeholder="hello@example.com" type="email" id="Email-address" required=""></div>
              <div class="contact-form-field-block"><label for="Password" class="contact-form-field-label">Password</label><input class="contact-form-text-field w-input" maxlength="256" name="Password" data-name="Password" placeholder="Password" type="password" id="Password" required=""></div>
              <div class="contact-form-button-block"><input type="submit" data-wait="Please wait..." class="primary-button auth w-button" value="Sign Up"></div>
              <div class="auth-form-bottom-block">
                <div class="auth-form-divider-block">
                  <div class="auth-form-liner"></div>
                  <div class="text-size-regular">or</div>
                  <div class="auth-form-liner"></div>
                </div>
                <div class="authentication-button-block">
                  <a href="#" class="authentication-button w-inline-block">
                    <div class="button-text">Sign Up with Google</div>
                    <div class="authentication-icon w-embed"><svg width="23" height="23" viewbox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M19.3139 11.6815C19.3139 11.1041 19.262 10.5489 19.1658 10.0159H11.4963V13.1658H15.8789C15.6901 14.1837 15.1164 15.0462 14.2539 15.6236V17.6668H16.8857C18.4255 16.2492 19.3139 14.1615 19.3139 11.6815Z" fill="#4285F4"></path>
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M11.4964 19.6396C13.695 19.6396 15.5384 18.9104 16.8857 17.6667L14.254 15.6235C13.5248 16.1121 12.592 16.4008 11.4964 16.4008C9.3754 16.4008 7.58018 14.9683 6.93983 13.0436H4.21924V15.1534C5.55917 17.8148 8.31308 19.6396 11.4964 19.6396Z" fill="#34A853"></path>
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M6.93989 13.0436C6.77702 12.555 6.68448 12.0331 6.68448 11.4964C6.68448 10.9597 6.77702 10.4378 6.93989 9.9492V7.83936H4.2193C3.66778 8.9387 3.35315 10.1824 3.35315 11.4964C3.35315 12.8104 3.66778 14.0541 4.2193 15.1535L6.93989 13.0436Z" fill="#FBBC05"></path>
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M11.4964 6.59195C12.6919 6.59195 13.7654 7.00281 14.6093 7.80973L16.9449 5.4741C15.5347 4.16007 13.6913 3.35315 11.4964 3.35315C8.31308 3.35315 5.55917 5.17798 4.21924 7.83935L6.93983 9.94919C7.58018 8.02442 9.3754 6.59195 11.4964 6.59195Z" fill="#EA4335"></path>
                      </svg></div>
                  </a>
                </div>
                <div class="authentication-link-button-block">
                  <p class="authentication-bottom-text">Already have an account? <span class="authentication-bottom-link">Sign In</span></p>
                </div>
              </div>
            </div>
          </form>
          <div class="success-message w-form-done">
            <div>Thank you! Your submission has been received!</div>
          </div>
          <div class="w-form-fail">
            <div>Oops! Something went wrong while submitting the form.</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
