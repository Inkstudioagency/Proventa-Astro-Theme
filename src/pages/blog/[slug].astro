---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import CollectionList from '../../components/CollectionList.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getBlogs, mediaUrl, formatDate, richText, type Blog } from '../../lib/strapi';

export async function getStaticPaths() {
  const blogs = await getBlogs();
  return blogs.map((blog) => ({
    params: { slug: blog.slug },
    props: {
      blog,
      related: blogs.filter((b) => b.slug !== blog.slug && b.category === blog.category).slice(0, 3),
    },
  }));
}

interface Props {
  blog: Blog;
  related: Blog[];
}

const { blog, related } = Astro.props;

const socials = [blog.socialLinkOne, blog.socialLinkTwo, blog.socialLinkThree, blog.socialLinkFour];
---

<BaseLayout
  title={`${blog.title} || Saas Astro Theme`}
  description={blog.summary}
  ogImage={mediaUrl(blog.mainImage)}
  wfPage="6a6ade7014d4ca494252bfe2"
>
  <div class="page-wrapper">
    <Navbar />
    <main class="main-wrapper">
      <section class="section_hero">
        <div class="hero-gap">
          <div class="w-layout-blockcontainer container-main w-container">
            <div class="hero-wrapper">
              <div class="hero-content-block">
                <div class="hero-title-block medium">
                  <h1 class="heading-style-1 title-animation">{blog.title}</h1>
                </div>
              </div>
              <div data-w-id="63b27c19-1a11-a449-dd05-d5b1ae6d3dae" style="opacity:0;-webkit-transform:translate3d(0, 80px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 80px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 80px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 80px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)" class="blog-hero-image-block"><img src={mediaUrl(blog.mainImage)} loading="lazy" alt={blog.title} class="blog-hero-image"></div>
            </div>
          </div>
        </div>
      </section>
      <section class="section_blog-details">
        <div class="blog-details-gap">
          <div class="w-layout-blockcontainer container-main w-container">
            <div data-w-id="02714072-d656-e923-f635-212c84ab0e2b" style="opacity:0;-webkit-transform:translate3d(0, 80px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 80px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 80px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 80px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)" class="blog-details-wrapper">
              <div class="blog-details-info-block">
                <div class="blog-details-client-block"><img src={mediaUrl(blog.authorImage)} loading="lazy" alt="" class="blog-card-author-image lg">
                  <div class="blog-details-client-text-block">
                    <div class="blog-card-author-name lg">{blog.authorName}</div>
                    <p class="blog-card-author-designation">{blog.authorDesignation}</p>
                  </div>
                </div>
                <div class="blog-details-date-block">
                  <div class="blog-card-author-name lg">Published</div>
                  <p class="blog-card-author-designation">{formatDate(blog.publishDate)}</p>
                </div>
                <div class="blog-details-social-block">
                  <div class="blog-card-author-name lg">Share</div>
