---
const path = Astro.url.pathname.replace(/(.)\/$/, '$1');
const is = (href: string) => path === href;
const cur = (href: string) => (is(href) ? 'page' : undefined);
const cls = (base: string, href: string) => (is(href) ? `${base} w--current` : base);
